# libFuzzer dictionary for TauQL (and the wire format).
# Keywords are UPPERCASE (case-sensitive); type names, aggregate functions and
# value literals are lowercase. Punctuation and wire tokens included so the
# mutator can assemble structurally-valid inputs faster.

# Statement keywords (UPPERCASE)
kw_create="CREATE"
kw_database="DATABASE"
kw_lens="LENS"
kw_user="USER"
kw_password="PASSWORD"
kw_append="APPEND"
kw_batch="BATCH"
kw_copy="COPY"
kw_from="FROM"
kw_to="TO"
kw_derive="DERIVE"
kw_xderive="XDERIVE"
kw_as="AS"
kw_over="OVER"
kw_at="AT"
kw_of="OF"
kw_layer="LAYER"
kw_range="RANGE"
kw_where="WHERE"
kw_limit="LIMIT"
kw_offset="OFFSET"
kw_reduce="REDUCE"
kw_using="USING"
kw_drop="DROP"
kw_use="USE"
kw_show="SHOW"
kw_databases="DATABASES"
kw_lenses="LENSES"
kw_users="USERS"
kw_status="STATUS"
kw_grants="GRANTS"
kw_grant="GRANT"
kw_revoke="REVOKE"
kw_on="ON"
kw_history="HISTORY"
kw_backup="BACKUP"
kw_restore="RESTORE"
kw_set="SET"
kw_unset="UNSET"
kw_ttl="TTL"
kw_start="START"
kw_transaction="TRANSACTION"
kw_commit="COMMIT"
kw_rollback="ROLLBACK"

# Type names (lowercase)
ty_int="int"
ty_float="float"
ty_str="str"
ty_bool="bool"
ty_bytes="bytes"

# Aggregate functions (lowercase)
agg_min="min"
agg_max="max"
agg_avg="avg"
agg_sum="sum"
agg_count="count"

# Value literals (lowercase)
lit_true="true"
lit_false="false"
lit_null="null"

# Permission letters / wildcards
perm_cruda="CRUDA"
perm_star="*"
perm_none="-"

# Operators and punctuation
op_and="&&"
op_or="||"
op_eq="=="
op_ne="!="
op_le="<="
op_ge=">="
op_lt="<"
op_gt=">"
op_add="+"
op_sub="-"
op_mul="*"
op_div="/"
op_mod="%"
op_not="!"
p_lparen="("
p_rparen=")"
p_lbrace="{"
p_rbrace="}"
p_comma=","
p_semi=";"
p_quote="\""

# Wire response tokens (for the wire / value_decode targets)
w_ok="OK"
w_val="VAL"
w_nil="NIL"
w_range="RANGE"
w_names="NAMES"
w_layers="LAYERS"
w_err="ERR"
w_auth="AUTH"
w_tag_i="i"
w_tag_f="f"
w_tag_s="s"
w_tag_b="b"
w_tag_n="n"
w_sep="; "
w_colon=":"
