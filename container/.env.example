# Copy to .env and fill in secrets before running `docker compose up`.
# Never commit a populated .env to source control.

# Bootstrap admin credentials. These seed the persisted users.json on the
# very first start of a fresh tau_data volume; subsequent restarts use the
# stored argon2id hash from users.json (the plaintext password env var is
# still consumed by --password but is only matched against the stored hash).
TAU_USERNAME=admin
TAU_PASSWORD=changeme_use_a_strong_password

# Optional AES-256-GCM encryption-at-rest for WAL + disk store.
# 64 hex chars (32 bytes). Generate with: openssl rand -hex 32
TAU_ENCRYPTION_KEY=

# Pinned image tag. Leave at "latest" to track the most recent release or pin
# to a release tag (e.g. v1.2.3) for reproducible deployments.
TAU_IMAGE_TAG=latest

# Server tuning
TAU_LOG_LEVEL=info
TAU_COMPACT_THRESHOLD=8

# Host bind interfaces. Default to loopback so nothing is exposed beyond the
# local host unless you opt in. Use 0.0.0.0 to bind all interfaces.
TAU_BIND_ADDR=127.0.0.1
TAU_METRICS_BIND_ADDR=127.0.0.1
PROM_BIND_ADDR=127.0.0.1
GRAFANA_BIND_ADDR=127.0.0.1

# Resource ceilings (docker deploy.resources.limits)
TAU_CPU_LIMIT=2.0
TAU_MEM_LIMIT=512M

# Prometheus retention.
PROM_RETENTION=30d
PROM_RETENTION_SIZE=8GB

# Grafana admin credentials. Required at first start.
GRAFANA_USER=admin
GRAFANA_PASSWORD=changeme_grafana_password

# External URL Grafana is reachable at (used in alert and share links).
GF_SERVER_ROOT_URL=http://localhost:3000
