# Tau benchmark runner image.
#
# Builds the `benchtau` binary (crates/bench) the same way container/Dockerfile
# builds the `tau` server: static musl binary on scratch. Used by
# docker-compose.bench.yml to produce reproducible, resource-capped
# benchmark numbers.
#
# Build args:
#   RUST_VERSION  - must match rust-toolchain.toml (default: 1.94.1)
#   BUILD_PROFILE - release (default) or release-lto for fat-LTO

ARG RUST_VERSION=1.94.1
ARG BUILD_PROFILE=release

FROM rust:${RUST_VERSION}-alpine AS chef

RUN apk add --no-cache musl-dev \
    && cargo install cargo-chef --locked --version 0.1.71 \
    && rm -rf "$CARGO_HOME/registry"

WORKDIR /build

FROM chef AS planner

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/ crates/

RUN cargo chef prepare --recipe-path recipe.json --bin benchtau

FROM chef AS builder

ARG BUILD_PROFILE

COPY --from=planner /build/recipe.json recipe.json
RUN cargo chef cook --profile ${BUILD_PROFILE} --bin benchtau --recipe-path recipe.json

COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY crates/ crates/

RUN cargo build --profile ${BUILD_PROFILE} --bin benchtau \
    && strip target/${BUILD_PROFILE}/benchtau \
    && cp target/${BUILD_PROFILE}/benchtau /benchtau

FROM scratch

LABEL org.opencontainers.image.source="https://github.com/bxrne/tau"
LABEL org.opencontainers.image.description="Tau benchmark workload runner (scratch musl static)."
LABEL org.opencontainers.image.licenses="LicenseRef-PolyForm-Noncommercial-1.0.0"
LABEL org.opencontainers.image.title="tau-bench"

COPY --from=builder /benchtau /benchtau

VOLUME ["/data"]

ENTRYPOINT ["/benchtau"]
CMD ["--preset", "quick", "--scale", "1000", "--format", "json", "--output", "/data/results.json"]
