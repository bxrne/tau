        { "expr": "histogram_quantile(0.95, sum by (le) (rate(tau_wal_write_duration_microseconds_bucket[1m])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(tau_wal_write_duration_microseconds_bucket[1m])))", "legendFormat": "p99", "refId": "C" }
