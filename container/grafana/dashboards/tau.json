{
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Production observability for the Tau time-series database.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "title": "Overview",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "tau-prometheus" },
      "description": "Server liveness from the Prometheus up metric.",
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] },
          "mappings": [{ "options": { "0": { "text": "DOWN" }, "1": { "text": "UP" } }, "type": "value" }]
        }
      },
      "gridPos": { "h": 4, "w": 3, "x": 0, "y": 1 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false }, "textMode": "value" },
      "title": "Status",
      "type": "stat",
      "targets": [{ "datasource": { "type": "prometheus", "uid": "tau-prometheus" }, "expr": "up{job=\"tau\"}", "legendFormat": "up", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "tau-prometheus" },
      "description": "Statements per second across all operation types.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 10000 }] }, "unit": "ops" } },
      "gridPos": { "h": 4, "w": 3, "x": 3, "y": 1 },
      "id": 2,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "title": "Throughput",
      "type": "stat",
      "targets": [{ "expr": "sum(rate(tau_statements_total[5m]))", "legendFormat": "stmt/s", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "tau-prometheus" },
      "description": "Currently open TCP connections.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 900 }] }, "unit": "short" } },
      "gridPos": { "h": 4, "w": 3, "x": 6, "y": 1 },
      "id": 3,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "title": "Active connections",
      "type": "stat",
      "targets": [{ "expr": "tau_connections_active", "legendFormat": "active", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "tau-prometheus" },
      "description": "Fraction of requests answered with ERR.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.05 }, { "color": "red", "value": 0.25 }] }, "unit": "percentunit" } },
      "gridPos": { "h": 4, "w": 3, "x": 9, "y": 1 },
      "id": 4,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "title": "Error rate",
      "type": "stat",
      "targets": [{ "expr": "rate(tau_errors_total[5m]) / (sum(rate(tau_statements_total[5m])) + 0.001)", "legendFormat": "err", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "tau-prometheus" },
      "description": "Fraction of AUTH attempts that failed.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 0.20 }, { "color": "red", "value": 0.50 }] }, "unit": "percentunit" } },
      "gridPos": { "h": 4, "w": 3, "x": 12, "y": 1 },
      "id": 5,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "title": "Auth fail rate",
      "type": "stat",
      "targets": [{ "expr": "rate(tau_auth_failures_total[5m]) / (rate(tau_auth_attempts_total[5m]) + 0.001)", "legendFormat": "fail", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "tau-prometheus" },
      "description": "Compactions per second. Each event is a sweep-line merge of one lens's layer stack.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 100 }] }, "unit": "ops" } },
      "gridPos": { "h": 4, "w": 3, "x": 15, "y": 1 },
      "id": 6,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "title": "Compactions/s",
      "type": "stat",
      "targets": [{ "expr": "rate(tau_compactions_total[1m])", "legendFormat": "compactions/s", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "tau-prometheus" },
      "description": "Connection rejections at the --max-connections cap.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1 }, { "color": "red", "value": 100 }] }, "unit": "ops" } },
      "gridPos": { "h": 4, "w": 3, "x": 18, "y": 1 },
      "id": 7,
      "options": { "colorMode": "background", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "title": "Conn rejections/s",
      "type": "stat",
      "targets": [{ "expr": "rate(tau_rejected_connections_total[5m])", "legendFormat": "rej/s", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "tau-prometheus" },
      "description": "p99 WAL write latency. High values indicate fsync pressure.",
      "fieldConfig": { "defaults": { "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 1000 }, { "color": "red", "value": 10000 }] }, "unit": "µs" } },
      "gridPos": { "h": 4, "w": 3, "x": 21, "y": 1 },
      "id": 8,
      "options": { "colorMode": "value", "graphMode": "area", "reduceOptions": { "calcs": ["lastNotNull"], "values": false } },
      "title": "WAL write p99",
      "type": "stat",
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le) (rate(tau_wal_write_duration_microseconds_bucket[5m])))", "legendFormat": "p99", "refId": "A" }]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "id": 110,
      "title": "Throughput",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "tau-prometheus" },
      "description": "Statement throughput by type. All 13 categories shown.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }, "unit": "ops" } },
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 6 },
      "id": 11,
      "options": { "legend": { "calcs": ["mean", "lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "title": "Statements/s by type",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (type) (rate(tau_statements_total[1m]))", "legendFormat": "{{type}}", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "tau-prometheus" },
      "description": "Active connections gauge and acceptance / rejection rates.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" } } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 6 },
      "id": 12,
      "options": { "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "title": "Connections",
      "type": "timeseries",
      "targets": [
        { "expr": "tau_connections_active", "legendFormat": "active", "refId": "A" },
        { "expr": "rate(tau_connections_total[1m])", "legendFormat": "accepted/s", "refId": "B" },
        { "expr": "rate(tau_rejected_connections_total[1m])", "legendFormat": "rejected/s", "refId": "C" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "tau-prometheus" },
      "description": "Compaction events per second and total count. Each event is a sweep-line merge of all layers for one lens.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }, "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 14 },
      "id": 13,
      "options": { "legend": { "calcs": ["mean", "lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi" } },
      "title": "Compactions/s",
      "type": "timeseries",
      "targets": [{ "expr": "rate(tau_compactions_total[1m])", "legendFormat": "compactions/s", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "tau-prometheus" },
      "description": "Per-database statement breakdown. Shows which databases are hottest.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 10, "lineWidth": 1, "showPoints": "never" }, "unit": "ops" } },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 14 },
      "id": 14,
      "options": { "legend": { "calcs": ["mean", "lastNotNull"], "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "title": "Statements/s by database",
      "type": "timeseries",
      "targets": [{ "expr": "sum by (db) (rate(tau_db_statements_total[1m]))", "legendFormat": "{{db}}", "refId": "A" }]
    },

    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 22 },
      "id": 120,
      "title": "Latency",
      "type": "row"
    },
    {
      "datasource": { "type": "prometheus", "uid": "tau-prometheus" },
      "description": "p50 executor latency per statement type.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never" }, "unit": "µs" } },
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 23 },
