    {
      "datasource": { "type": "prometheus", "uid": "tau-prometheus" },
      "description": "p95 executor latency per statement type.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never" }, "unit": "µs" } },
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 23 },
      "id": 22,
      "options": { "legend": { "calcs": ["mean", "lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "title": "p95 latency (µs)",
      "type": "timeseries",
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, type) (rate(tau_statement_duration_microseconds_bucket[5m])))", "legendFormat": "p95 {{type}}", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "tau-prometheus" },
      "description": "p99 executor latency per statement type.",
      "fieldConfig": { "defaults": { "color": { "mode": "palette-classic" }, "custom": { "drawStyle": "line", "fillOpacity": 5, "lineWidth": 1, "showPoints": "never" }, "unit": "µs" } },
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 23 },
      "id": 23,
      "options": { "legend": { "calcs": ["mean", "lastNotNull", "max"], "displayMode": "table", "placement": "right", "showLegend": true }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "title": "p99 latency (µs)",
      "type": "timeseries",
      "targets": [{ "expr": "histogram_quantile(0.99, sum by (le, type) (rate(tau_statement_duration_microseconds_bucket[5m])))", "legendFormat": "p99 {{type}}", "refId": "A" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "tau-prometheus" },
      "description": "WAL write latency percentiles. Spikes indicate fsync pressure or I/O contention.",
